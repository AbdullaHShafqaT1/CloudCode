# =============================================================
# LegacyNode — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# =============================================================

# ------------------------------------------------------------------
# Tunnel Endpoint (set this after starting your cloud runner)
# The public HTTPS URL that Cloudflare/zrok exposes for your LLM.
# Example: https://random-word-phrase.trycloudflare.com
# ------------------------------------------------------------------
TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# ------------------------------------------------------------------
# LLM Model name as served by Ollama / vLLM on the cloud runner.
# Examples: qwen2.5-coder:32b, qwen2.5-coder:72b, qwen3:32b
# ------------------------------------------------------------------
LLM_MODEL=qwen2.5-coder:32b

# ------------------------------------------------------------------
# Optional: API key if your tunnel is behind basic auth or vLLM
# Leave as "ollama" for standard Ollama deployments.
# ------------------------------------------------------------------
LLM_API_KEY=ollama

# ------------------------------------------------------------------
# Optional: zrok account token (only needed if using zrok fallback)
# ------------------------------------------------------------------
ZROK_TOKEN=

# ------------------------------------------------------------------
# Optional: ngrok authtoken (only needed if switching to ngrok)
# ------------------------------------------------------------------
NGROK_AUTHTOKEN=
